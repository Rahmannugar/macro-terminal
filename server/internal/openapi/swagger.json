    "paths": {
        "/api/v1/account": {
            "get": {
                "description": "Resolves the session cookie to the local account, creating the user projection on first use. The email comes from the identity provider.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/authentication.accountResponse"
                                }
                            }
                        },
                        "description": "The account and its session."
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "No valid session exists."
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The account is suspended."
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request could not be completed."
                    }
                },
                "summary": "Get the signed-in account.",
                "tags": [
                    "account"
                ]
            },
            "patch": {
                "description": "Stores a display username on the signed-in account. The username is optional and is not used to sign in.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/authentication.updateUsernameRequest",
                                "summary": "body",
                                "description": "The username to store, 1 to 64 characters."
                            }
                        }
                    },
                    "description": "The username to store, 1 to 64 characters.",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/authentication.accountResponse"
                                }
                            }
                        },
                        "description": "The updated account and its session."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The username is missing or too long."
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "No valid session exists."
                    },
                    "403": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The account is suspended."
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request could not be completed."
                    }
                },
                "summary": "Set the account username.",
                "tags": [
                    "account"
                ]
            }
        },
        "/api/v1/articles/{id}": {
            "get": {
                "description": "Returns a single article by id.",
                "parameters": [
                    {
                        "description": "Article id (UUID).",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/articles.articleResponse"
                                }
                            }
                        },
                        "description": "The article."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request was malformed."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The article does not exist."
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request could not be completed."
                    }
                },
                "summary": "Get one article.",
                "tags": [
                    "articles"
                ]
            }
        },
        "/api/v1/articles/{id}/explain": {
            "post": {
                "description": "Generates a one-shot contextual explanation of the article from its enrichment, graph entities, affected asset pairs, story cluster, related coverage, and knowledge terms. The generated answer is cached briefly and regenerated after it expires.",
                "parameters": [
                    {
                        "description": "Article id (UUID).",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/explanation.explanationResponse"
                                }
                            }
                        },
                        "description": "The explanation."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request was malformed."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The article does not exist."
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request could not be completed."
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The explanation service is unavailable."
                    }
                },
                "summary": "Explain one article with AI.",
                "tags": [
                    "articles"
                ]
            }
        },
        "/api/v1/articles/{id}/related": {
            "get": {
                "description": "Returns story cluster mates first (most recent first), then semantically similar indexed articles, deduplicated and excluding the article itself. When semantic search is not configured only cluster mates are returned.",
                "parameters": [
                    {
                        "description": "Article id (UUID).",
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Page size between 1 and 100. Defaults to 25.",
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/clustering.relatedResponse"
                                }
                            }
                        },
                        "description": "The related articles, cluster mates first."
                    },
                    "400": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request was malformed."
                    },
                    "404": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The article does not exist."
                    },
                    "429": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "Too many requests. Retry after the indicated delay."
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "The request could not be completed."
                    },
                    "503": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/openapi.Error"
                                }
                            }
                        },
                        "description": "Semantic search is unavailable."
                    }
                },
                "summary": "Get articles related to one article.",
                "tags": [
                    "articles"
                ]
            }
        },
