# Copy to deploy/.env for standalone runs (docker compose --env-file deploy/.env).
# On the server the same names live in the deployment environment; any
# MACRO_TERMINAL_* value stored in AWS Secrets Manager is merged in at
# container start by /app/entrypoint.sh (when MACRO_TERMINAL_SECRETS_ARN is set).

# Required — postgres boots with this before any secret loading exists.
MACRO_TERMINAL_DATABASE_PASSWORD=

# Required app values (deployment environment or Secrets Manager).
MACRO_TERMINAL_AUTH_BASE_URL=https://macroterminal.consumel.com
MACRO_TERMINAL_AUTH_CLIENT_BASE_URL=https://macroterminal.consumel.com
MACRO_TERMINAL_AUTH_TRUSTED_ORIGINS=https://macroterminal.consumel.com
MACRO_TERMINAL_AUTH_OTP_HMAC_SECRET=

# AWS Secrets Manager fetch at container start (leave empty to skip).
MACRO_TERMINAL_SECRETS_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Optional overrides (defaults shown where they exist in code).
MACRO_TERMINAL_DATABASE_NAME=macro_terminal
MACRO_TERMINAL_DATABASE_USER=macro_terminal
MACRO_TERMINAL_ENVIRONMENT=production
MACRO_TERMINAL_AI_API_KEY=
MACRO_TERMINAL_BLS_API_KEY=
MACRO_TERMINAL_BEA_API_KEY=
MACRO_TERMINAL_EIA_API_KEY=
ESTAT_APP_ID=
STATSNZ_API_KEY=
MACRO_TERMINAL_RESEND_API_KEY=
MACRO_TERMINAL_RESEND_NOREPLY_FROM=
MACRO_TERMINAL_RETENTION_ARTICLE_DAYS=183
